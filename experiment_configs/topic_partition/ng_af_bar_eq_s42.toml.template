# TOPIC-PARTITION-20NG arm ng_af_bar_eq_s42 (docs/judge_v2_program.md, "Registered 2026-09-22 (before any code or call) -
# TOPIC-PARTITION-20NG", L10030-L10390, registration commit 6aa2a0d; plan Amendment 8). ZERO judge calls;
# label-free (enableLabeling false, judgeInduction false, runBenchmark false); embeddings local (Ollama
# qwen3-embedding). The tree this builds is STRUCTURAL EVIDENCE ONLY; nothing is promoted or judged.
#
# T2 CONTINGENCY TEMPLATE (registration I4): run ONLY if T1 is NOT BUILT (the [ANCHOR-FREE] vacuity guard fired,
# TaxonomyEngine.kt L786-790, or leaves <= 7). T1 body with ONE key changed: proposalSeparationBar = 0.025 x
# (sep_root_T1 / 0.042461), sep_root_T1 = the root's refused k = 2 min-pair in T1's diagnostics/proposals.csv
# (reason min_pair_sep_below_bar), 0.042461 = R1 af_clean_s42's root k = 2 separation (site_null_af_clean_s42.csv);
# if the root ACCEPTED and the collapse is below it, the largest refused depth-1 min-pair over R1's largest refused
# depth-1 min-pair analogously; clipped to [0.010, 0.025]. The value is computed by the chain
# (tools/chains/topic_partition.sh, t2_bar), printed, and written into ng_af_bar_eq_s42.toml from this template by
# replacing the placeholder line below; the chain REFUSES to instantiate the template unless the trigger holds.
# This .template file is NOT a config (not parsed by ConfigParsesTest); the instantiated TOML is. T2's Q1/Q2 rows
# are printed "bar re-tuned"; its certified count is never compared to T1's or to the record's.
#
# The corpus's own split (testRatio 0.30, seed 42, per label, MMLUDatasetFetcher.splitTrainTest) is the held-out
# side; reservedPoolFile and pool are ABSENT by registration (the pool id becomes known at build time and is
# exported with `pool_guard.py --export-snapshot`, then verified with `pool_guard.py --pool <id> --db
# <corpus db> --id-file <export>`). models = [] (read only inside the benchmark block, runner L708 ff.; no
# eval row exists for this corpus). No `seeds = [...]`. Own ratings db:
# -Dranking.db.path=ratings_topic_partition_ng_af_bar_eq_s42.db at the repo root (set by tools/chains/topic_partition.sh).
# Verified at build time from the manifest: anchor_free true, proposal_accept_multiplier 1.0 (key ABSENT),
# embedding_model qwen3-embedding:latest, and the "[SLICE] embedding slice width" line.
#
datasetType   = "TWENTY_NEWSGROUPS"
corpusDbPath  = "twenty_newsgroups_cache_v1.db"

models        = []

category      = ""
queryLimit    = 0
outputDir     = "experiment_results/topic_partition/ng_af_bar_eq_s42"
testRatio     = 0.3
seed          = 42

# Body = o0_s42.toml (seed 42 = the frozen build's split and construction seed). The ONE
# instrument key of this registration; o0 differs from this file only by its absence.
anchorFree = true

runPipeline        = true
runBenchmark       = false
runTrickle         = true
runBaselines       = false
enableFinalMetrics = false
enableLabeling     = false
judgeInduction     = false

dagMode = "DAG_MAX"

maxDepth              = 8
minClusterSize        = 55
proposalSeparationBar = @T2_BAR@   # T2: filled by the chain (I4); the placeholder must not survive
tau                   = 1e-6
acceptanceZ           = 2.0
enableRefitGate       = false

membershipFloor       = 0.25
routingBeamGamma      = 0.2
descentMargin         = 0.12

effectiveSupportFloor = 2.0
defaultKappaPrior     = 10.0

numIterations         = 50
maxLeafAssignments    = 5

fusionSimilarityThreshold = 0.90
enableGtWarmStart         = false

enableProfiling           = true
