# Archived and parked artefacts: kept on disk, documented by their manifests,
# but not tracked. The two archive manifests are re-included below.
archive/**
!archive/ARCHIVE_MANIFEST.md
!archive/README.md
testing/

# Ratings-store variants (backups, secured copies, trials) and secured export folders
*.db.*
*_secured/*
!*_secured/MAIN_thesis_metrics.csv

# Regenerable tuning run outputs
tuning/runs/*/output/

# Temporary and state output files
*.tmp
copied_snapshot_id.txt
compile.log
algorithm_trace.log
frozen_triples_*.json
answer_matrix_missingness.csv
experiment_*.toml
reserved_test_queries.json
eval_results/
*.zip

# Settled-batch results record: the result databases and the frozen MAIN
# triples are tracked despite the global *.db / frozen_triples_* rules.
!experiment_results/**/*.db
!frozen_triples_20260727_042523_Headless_Run_Auto_ge_MAIN.json

# /ratings.db is NOT tracked (untracked 2026-08-08). It is the DEFAULT write target
# of any run launched without -Dranking.db.path, so tracking it meant a routine run
# silently modified a committed 8 MB binary — which is exactly what happened during
# the cross-domain trial. Nothing in the replication path reads it: the settled
# results live in experiment_results/r8/*/ratings_r8_*.db, and generate_baselines.py
# reads mmlu_pro_dataset_cache_v2.db despite the variable being named ratings_db.
# HeadlessBenchmarkRunner now refuses to start when the resolved database is
# git-tracked; see taxonomy.runner.RatingsDbGuard.

# Frozen-snapshot extract for replication (full snapshots.db stays local-only)
!/snapshots_frozen.db
